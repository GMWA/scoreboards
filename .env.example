API_BASE_URL=http://localhost:5000/api
DEBUG_MODE=true
WEBSITE_URL=https://scoreboards.cm

# Firebase Cloud Messaging (push notifications), Android app of the
# Firebase project. From google-services.json: client[0].api_key[0].current_key,
# client[0].client_info.mobilesdk_app_id, project_info.project_number and
# project_info.project_id. Left empty, push notifications are off and the
# setting is hidden.
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
