# Copy to .sentry.env (gitignored) to enable Sentry in release builds made
# with scripts/build_*.sh. Never commit the real file: this repo is public.
#
# Without SENTRY_DSN, builds run without crash reporting.
# Without SENTRY_AUTH_TOKEN, builds work but debug symbols aren't uploaded,
# so stack traces from the obfuscated app won't be readable.

# Project settings > Client Keys (DSN)
SENTRY_DSN=
# Settings > Developer Settings > Organization Tokens (starts with sntrys_).
# A personal token works too, with the project:releases and org:read scopes.
SENTRY_AUTH_TOKEN=
# Slugs from the project URL: https://<org>.sentry.io/projects/<project>/
SENTRY_ORG=
SENTRY_PROJECT=
